BOT_TOKEN=
BOT_USERNAME=

# Supabase (PostgreSQL gerenciado)
# No painel do Supabase: Project Settings -> Database -> Connection string
# Use a string "URI" e troque a porta para 5432 (modo sessão, recomendado p/ o bot)
# Exemplo:
#   postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Sempre use o prefixo +asyncpg e DATABASE_SSL=require (Supabase exige SSL)
DATABASE_URL=postgresql+asyncpg://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# Admins: por ID numérico (ADMIN_IDS) e/ou por username (ADMIN_USERNAMES), separados por vírgula
ADMIN_IDS=
ADMIN_USERNAMES=rscs7,eupedromv

AFFILIATE_PERCENTAGE=25
PIX_EXPIRATION_MINUTES=30
MIN_DEPOSIT_AMOUNT=1
MAX_DEPOSIT_AMOUNT=5000

FREEPAY_API_URL=https://api.freepaybrasil.com
FREEPAY_PUBLIC_KEY=
FREEPAY_SECRET_KEY=
FREEPAY_WEBHOOK_SECRET=
FREEPAY_AMOUNT_IN_CENTS=true
FREEPAY_PIX_EXPIRES_IN_DAYS=1
FREEPAY_TIMEOUT_SECONDS=15
FREEPAY_RETRIES=1

WEBHOOK_BASE_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

ENVIRONMENT=development

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=10

LOG_LEVEL=INFO

SHOP_DESCRIPTION="💎 Produtos digitais
⚡ Entrega rápida
🔒 Pagamento seguro
📦 Sistema automatizado"

BENEFITS_TEXT="📅 Como funciona?
O sistema contabiliza automaticamente as compras qualificadas.
Quando o requisito for atingido:
✅ Benefício desbloqueado."
